# Used when running the frontend OUTSIDE of Docker (e.g. `npm run dev -w @shopiva/frontend`).
# Inside Docker Compose these are overridden by docker-compose.yml.

# Server-side base URL (SSR / route handlers).
# Inside Docker use: http://backend:4000
API_URL=http://localhost:4000

# Browser-side base URL (must be reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Store name shown across the storefront + admin panel.
NEXT_PUBLIC_STORE_NAME=فروشگاه شاپیوا
