# Used when running the frontend OUTSIDE of Docker.
# Inside Docker Compose these are overridden by docker-compose.yml.

# Server-side base URL (SSR / route handlers).
# Inside Docker use: http://backend:4000
API_URL=http://localhost:4000

# Browser-side base URL (must be reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Root domain used by middleware to extract the store subdomain from the Host
# header. Use "localhost" for local dev (*.localhost), or your apex domain in
# production (e.g. shopiva.app). Test locally with acme.localhost:3000 or ?store=acme.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
ROOT_DOMAIN=localhost
