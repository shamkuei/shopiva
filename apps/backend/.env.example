# Used when running the backend OUTSIDE of Docker (e.g. `npm run dev -w @shopiva/backend`).
# Inside Docker Compose these are overridden by docker-compose.yml (host = `postgres`).

NODE_ENV=development
PORT=4000

# Local Postgres (point to localhost when not using Docker).
DATABASE_URL="postgresql://shopiva:shopiva@localhost:5432/shopiva?schema=public"
REDIS_URL="redis://localhost:6379"

# Subdomain of the default store served when no `x-store-subdomain` header is sent.
STORE_DEFAULT_SUBDOMAIN=default
CORS_ORIGIN=http://localhost:3000

# Auth (JWT + cookies). Change secrets outside local dev.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
