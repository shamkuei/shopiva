# Used when running the backend OUTSIDE of Docker (e.g. `npm run dev -w @shopiva/backend`).
# Inside Docker Compose these are overridden by docker-compose.yml (host = `postgres`).

NODE_ENV=development
PORT=4000

# Local Postgres (point to localhost when not using Docker).
DATABASE_URL="postgresql://shopiva:shopiva@localhost:5432/shopiva"
REDIS_URL="redis://localhost:6379"

CORS_ORIGIN=http://localhost:3000

# Auth (JWT + cookies). Change secrets outside local dev.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Zarinpal gateway (sandbox by default). Set your merchant ID.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/payments/callback
WEB_URL=http://localhost:3000
