# ─────────────────────────────────────────────────────────────
# Shopiva — root environment.
# Copy this file to `.env` (at the repo root) before running:
#   cp .env.example .env
# docker compose reads .env automatically for ${VAR} substitution.
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL 16 ───
POSTGRES_USER=shopiva
POSTGRES_PASSWORD=shopiva
POSTGRES_DB=shopiva
POSTGRES_PORT=5432

# ─── Redis ───
REDIS_PORT=6379

# ─── Runtime ───
NODE_ENV=development

# Host ports (change if something on your machine already uses these)
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ─── Backend runtime config ───
# Subdomain of the store to serve when no `x-store-subdomain` header is sent.
# A store with this subdomain is created automatically by the seed script.
STORE_DEFAULT_SUBDOMAIN=default
# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ───
# Browser-facing API base URL (must be reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Auth (JWT + cookies) ───
# CHANGE these secrets in any non-local environment (use `openssl rand -hex 32`).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# ─── Payments (Zarinpal) ───
# Your gateway merchant ID from the Zarinpal panel. Sandbox is on by default.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
# Backend callback the gateway redirects the browser back to (browser-reachable).
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/payments/callback
# Public frontend URL (where the backend redirects after verifying payment).
WEB_URL=http://localhost:3000

# ─── Production deployment (docker-compose.prod.yml) ──────────
# Apex domain — used by Caddy, CORS, and subdomain routing. In dev leave as
# localhost; in production set to your domain (e.g. shopiva.app).
ROOT_DOMAIN=localhost
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=admin@example.com
# In production, serve the API same-origin via the proxy — leave this empty so
# the browser calls /api (Caddy routes /api -> backend).
# NEXT_PUBLIC_API_URL=
# Seed the default store + sample products on boot (dev convenience; off in prod).
SEED_ON_BOOT=false
# How many days of DB backups to keep (see scripts/backup-db.sh).
BACKUP_RETENTION_DAYS=14
