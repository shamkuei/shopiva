# ─────────────────────────────────────────────────────────────
# Shopiva — root environment.
# Copy this file to `.env` (at the repo root) before running:
#   cp .env.example .env
# docker compose reads .env automatically for ${VAR} substitution.
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL 16 ───
POSTGRES_USER=shopiva
POSTGRES_PASSWORD=shopiva
POSTGRES_DB=shopiva
POSTGRES_PORT=5432

# ─── Redis ───
REDIS_PORT=6379

# ─── Runtime ───
NODE_ENV=development

# Host ports (change if something on your machine already uses these)
FRONTEND_PORT=3000
BACKEND_PORT=4000

# ─── Backend runtime config ───
# Comma-separated list of allowed CORS origins (the frontend URL).
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ───
# Browser-facing API base URL (must be reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Store name shown across the storefront + admin panel.
NEXT_PUBLIC_STORE_NAME=فروشگاه شاپیوا

# ─── Auth (JWT + cookies) ───
# CHANGE these secrets in any non-local environment (use `openssl rand -hex 32`).
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# ─── Payments (Zarinpal) ───
# Your gateway merchant ID from the Zarinpal panel (a UUID). The zero-UUID
# placeholder below only works in the sandbox. In production the backend
# REFUSES TO BOOT with a missing/placeholder/invalid merchant ID.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# Sandbox (test) gateway. MUST be false in production — the backend refuses
# to boot with sandbox on in prod (payments would silently charge nothing).
# Accepted values: exactly "true" or "false" — anything else fails the boot.
ZARINPAL_SANDBOX=true
# Backend callback the gateway redirects the browser back to (browser-reachable).
ZARINPAL_CALLBACK_URL=http://localhost:4000/api/payments/callback
# Public frontend URL (where the backend redirects after verifying payment).
WEB_URL=http://localhost:3000
# Pending orders older than this (minutes) are auto-cancelled and their stock
# restored by a background sweep (runs every 5 minutes).
PENDING_ORDER_TTL_MIN=60

# ─── Production deployment (docker-compose.prod.yml) ──────────
# The public domain the store is served on.
APP_DOMAIN=shopiva.app
# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=admin@example.com
# PRODUCTION PAYMENTS — set both of these for a real deploy:
#   ZARINPAL_SANDBOX=false          (backend refuses to boot otherwise)
#   ZARINPAL_MERCHANT_ID=<real UUID> (backend refuses to boot with the
#                                    zero-UUID placeholder or a non-UUID)
# In production, serve the API same-origin via the proxy — leave this empty so
# the browser calls /api (Caddy routes /api -> backend).
# NEXT_PUBLIC_API_URL=
# Boot-time seeding:
#   false → no seeding (default; use `docker compose exec backend npm run
#           create-admin` to provision the first admin, or set the values below)
#   admin → create ONLY the admin user from OWNER_EMAIL/OWNER_PASSWORD
#   true  → full demo seed (admin + sample products + orders; dev only)
SEED_ON_BOOT=false
# First-admin credentials. Used by SEED_ON_BOOT=admin and `npm run create-admin`.
# Dev fallback if unset: owner@shopiva.test / password123 — NEVER rely on that in prod.
# OWNER_EMAIL=admin@yourshop.ir
# OWNER_PASSWORD=change-me-min-8-chars
# How many days of DB backups to keep (see scripts/backup-db.sh).
BACKUP_RETENTION_DAYS=14
