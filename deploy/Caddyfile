# Shopiva production reverse proxy (Caddy) — single store on one domain.
#
# /api/* and /uploads/* -> backend; everything else -> Next.js frontend.
# Caddy issues + renews a Let's Encrypt certificate for {$APP_DOMAIN} automatically.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	@backend path /api/* /uploads/*
	reverse_proxy @backend backend:4000

	reverse_proxy frontend:3000
}
